{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "types": ["node"],

    "sourceMap": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src",
    "prisma.config.ts"
  ]
}